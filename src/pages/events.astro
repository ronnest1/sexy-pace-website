---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import { useTranslations } from "@/i18n/utils";
import EventList from "@/components/EventList";

const t = useTranslations("en");

const seo: AstroSeoProps = {
	title: "Sexy Pace Events - Join Our Running Community",
	description:
		"Join exciting running events and communities. From weekly training sessions to major races - find your next adventure.",
	canonical: "https://sexypace.com/events/",
};
---

<BaseLayout seo={seo}>
	<section class="section min-h-screen">
		<div class="wrapper col-span-12 py-32">
			<div class="mx-auto max-w-4xl">
				<h1 class="font-display text-5xl font-bold md:text-6xl lg:text-8xl text-center">{t("events.title")}</h1>
				<div class="mt-8 text-right">
					<a id="admin-link" href="/social-events/admin" class="hidden inline-flex items-center gap-2 rounded-full border border-pink-600 px-4 py-2 text-sm text-pink-600 hover:bg-pink-50">Admin</a>
				</div>
				<div class="mt-10">
					<EventList client:load />
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const pk = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;
	const link = document.getElementById('admin-link');
	if (pk && link) {
		const script = document.createElement('script');
		script.setAttribute('data-clerk-publishable-key', pk);
		script.src = 'https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js';
		script.async = true;
		script.addEventListener('load', async () => {
			// @ts-ignore
			const Clerk = window.Clerk;
			await Clerk.load();
			const render = () => {
				const u = Clerk.user;
				const isAdmin = !!u?.publicMetadata?.admin;
				if (isAdmin) link.classList.remove('hidden');
				else link.classList.add('hidden');
			};
			Clerk.addListener(render);
			render();
		});
		document.head.appendChild(script);
	}
</script>
