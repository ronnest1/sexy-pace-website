---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import { useTranslations } from "@/i18n/utils";
import bgRun from "@/assets/images/authors/social-run.jpg";

const t = useTranslations("da");

const seo: AstroSeoProps = {
	title: "Sexy Pace Events - Deltag i Vores Løbefællesskab",
	description:
		"Deltag i spændende løbeevents og fællesskaber. Fra ugentlige træninger til store løb - find dit næste eventyr.",
	canonical: "https://sexypace.com/da/events/",
};
---

<BaseLayout seo={seo}>
	<section class="section min-h-screen">
		<div class="wrapper col-span-12 py-32">
			<div class="mx-auto max-w-6xl text-center">
				<h1 class="font-display text-5xl font-bold md:text-6xl lg:text-8xl">{t("events.title")}</h1>
				<p class="mt-8 text-xl text-gray-600">
					{t("events.subtitle")}
				</p>
				
				<!-- 2026 Events Section -->
				<div class="mt-16">
					<h2 class="font-display text-3xl font-bold md:text-4xl mb-12">{t("events.2026.title")}</h2>
					
					<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2">
						<!-- Marathon -->
						<div class="group relative h-72 overflow-hidden rounded-lg bg-neutral-900 text-left md:h-80 lg:h-96" style={`background-image: url(${bgRun.src}); background-size: cover; background-position: center;`}>
							<div class="absolute inset-0 bg-black/40 transition-opacity duration-300 group-hover:bg-black/50"></div>
							<div class="absolute inset-x-0 bottom-0 p-6 md:p-8 text-white">
								<h3 class="text-2xl font-bold">{t("events.marathon.title")}</h3>
								<p class="mt-1 text-sm md:text-base font-semibold text-pink-300">{t("events.marathon.date")}</p>
								<p class="mt-3 max-w-prose text-sm md:text-base text-gray-100/90">{t("events.marathon.description")}</p>
								<div class="mt-5">
									<button class="inline-flex items-center rounded-full bg-pink-600 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-pink-500">
										{t("events.register")}
									</button>
								</div>
							</div>
						</div>

						<!-- Half Marathon -->
						<div class="group relative h-72 overflow-hidden rounded-lg bg-neutral-900 text-left md:h-80 lg:h-96" style={`background-image: url(${bgRun.src}); background-size: cover; background-position: center;`}>
							<div class="absolute inset-0 bg-black/40 transition-opacity duration-300 group-hover:bg-black/50"></div>
							<div class="absolute inset-x-0 bottom-0 p-6 md:p-8 text-white">
								<h3 class="text-2xl font-bold">{t("events.halfmarathon.title")}</h3>
								<p class="mt-1 text-sm md:text-base font-semibold text-pink-300">{t("events.halfmarathon.date")}</p>
								<p class="mt-3 max-w-prose text-sm md:text-base text-gray-100/90">{t("events.halfmarathon.description")}</p>
								<div class="mt-5">
									<button class="inline-flex items-center rounded-full bg-pink-600 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-pink-500">
										{t("events.register")}
									</button>
								</div>
							</div>
						</div>

						<!-- 10K Run -->
						<div class="group relative h-72 overflow-hidden rounded-lg bg-neutral-900 text-left md:h-80 lg:h-96" style={`background-image: url(${bgRun.src}); background-size: cover; background-position: center;`}>
							<div class="absolute inset-0 bg-black/40 transition-opacity duration-300 group-hover:bg-black/50"></div>
							<div class="absolute inset-x-0 bottom-0 p-6 md:p-8 text-white">
								<h3 class="text-2xl font-bold">{t("events.10km.title")}</h3>
								<p class="mt-1 text-sm md:text-base font-semibold text-pink-300">{t("events.10km.date")}</p>
								<p class="mt-3 max-w-prose text-sm md:text-base text-gray-100/90">{t("events.10km.description")}</p>
								<div class="mt-5">
									<button class="inline-flex items-center rounded-full bg-pink-600 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-pink-500">
										{t("events.register")}
									</button>
								</div>
							</div>
						</div>

						<!-- Test Din Pace Konkurrence -->
						<div class="group relative h-72 overflow-hidden rounded-lg bg-neutral-900 text-left md:h-80 lg:h-96" style={`background-image: url(${bgRun.src}); background-size: cover; background-position: center;`}>
							<div class="absolute inset-0 bg-black/40 transition-opacity duration-300 group-hover:bg-black/50"></div>
							<div class="absolute inset-x-0 bottom-0 p-6 md:p-8 text-white">
								<h3 class="text-2xl font-bold">{t("events.pace.title")}</h3>
								<p class="mt-1 text-sm md:text-base font-semibold text-pink-300">{t("events.pace.date")}</p>
								<p class="mt-3 max-w-prose text-sm md:text-base text-gray-100/90">{t("events.pace.description")}</p>
								<div class="mt-5">
									<button class="inline-flex items-center rounded-full bg-pink-600 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-pink-500">
										{t("events.register")}
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
