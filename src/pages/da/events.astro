---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("da");

const seo: AstroSeoProps = {
	title: "Sexy Pace Events - Deltag i Vores Løbefællesskab",
	description:
		"Deltag i spændende løbeevents og fællesskaber. Fra ugentlige træninger til store løb - find dit næste eventyr.",
	canonical: "https://sexypace.com/da/events/",
};
---

<BaseLayout seo={seo}>
	<section class="section min-h-screen">
		<div class="wrapper col-span-12 py-32">
			<div class="mx-auto max-w-6xl text-center">
				<h1 class="font-display text-5xl font-bold md:text-6xl lg:text-8xl">{t("events.title")}</h1>
				<p class="mt-8 text-xl text-gray-600">
					{t("events.subtitle")}
				</p>
				
				<!-- 2026 Events Section -->
				<div class="mt-16">
					<h2 class="font-display text-3xl font-bold md:text-4xl mb-12">{t("events.2026.title")}</h2>
					
					<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2">
						<!-- Marathon -->
						<div class="rounded-lg bg-gradient-to-br from-red-50 to-red-100 p-8 border border-red-200">
							<div class="text-4xl mb-4">🏃‍♂️</div>
							<h3 class="text-2xl font-bold text-red-800">{t("events.marathon.title")}</h3>
							<p class="mt-2 text-lg font-semibold text-red-600">{t("events.marathon.date")}</p>
							<p class="mt-4 text-gray-700">{t("events.marathon.description")}</p>
							<div class="mt-6 flex gap-4">
								<button class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 transition-colors">
									{t("events.register")}
								</button>
								<button class="border border-red-600 text-red-600 px-6 py-2 rounded-lg hover:bg-red-50 transition-colors">
									{t("events.moreinfo")}
								</button>
							</div>
						</div>

						<!-- Half Marathon -->
						<div class="rounded-lg bg-gradient-to-br from-blue-50 to-blue-100 p-8 border border-blue-200">
							<div class="text-4xl mb-4">🏃‍♀️</div>
							<h3 class="text-2xl font-bold text-blue-800">{t("events.halfmarathon.title")}</h3>
							<p class="mt-2 text-lg font-semibold text-blue-600">{t("events.halfmarathon.date")}</p>
							<p class="mt-4 text-gray-700">{t("events.halfmarathon.description")}</p>
							<div class="mt-6 flex gap-4">
								<button class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
									{t("events.register")}
								</button>
								<button class="border border-blue-600 text-blue-600 px-6 py-2 rounded-lg hover:bg-blue-50 transition-colors">
									{t("events.moreinfo")}
								</button>
							</div>
						</div>

						<!-- 10K Run -->
						<div class="rounded-lg bg-gradient-to-br from-green-50 to-green-100 p-8 border border-green-200">
							<div class="text-4xl mb-4">🏃</div>
							<h3 class="text-2xl font-bold text-green-800">{t("events.10km.title")}</h3>
							<p class="mt-2 text-lg font-semibold text-green-600">{t("events.10km.date")}</p>
							<p class="mt-4 text-gray-700">{t("events.10km.description")}</p>
							<div class="mt-6 flex gap-4">
								<button class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition-colors">
									{t("events.register")}
								</button>
								<button class="border border-green-600 text-green-600 px-6 py-2 rounded-lg hover:bg-green-50 transition-colors">
									{t("events.moreinfo")}
								</button>
							</div>
						</div>

						<!-- Test Din Pace Competition -->
						<div class="rounded-lg bg-gradient-to-br from-purple-50 to-purple-100 p-8 border border-purple-200">
							<div class="text-4xl mb-4">⏱️</div>
							<h3 class="text-2xl font-bold text-purple-800">{t("events.pace.title")}</h3>
							<p class="mt-2 text-lg font-semibold text-purple-600">{t("events.pace.date")}</p>
							<p class="mt-4 text-gray-700">{t("events.pace.description")}</p>
							<div class="mt-6 flex gap-4">
								<button class="bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition-colors">
									{t("events.register")}
								</button>
								<button class="border border-purple-600 text-purple-600 px-6 py-2 rounded-lg hover:bg-purple-50 transition-colors">
									{t("events.moreinfo")}
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
