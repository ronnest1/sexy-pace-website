---
import TermsPage from "@/components/infopages/Terms.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Servicevilkår - Majestico Studio: Forstå vores vilkår",
	description:
		"Læs servicevilkårene for Majestico Studio. Lær om vores retningslinjer og dit ansvar, når du bruger vores webdesign- og SEO-tjenester.",
	canonical: "https://mintaka.co/da/terms/",
};
---

<BaseLayout seo={seo}>
	<TermsPage />
</BaseLayout>
