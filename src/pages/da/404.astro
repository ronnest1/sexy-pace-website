---
import Error404 from "@/components/infopages/Error404.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "404 Fejl: Side ikke fundet - Majestico Studio",
	description:
		"Ups! Den side, du leder efter, eksisterer ikke. Naviger tilbage til Majestico Studios hjemmeside for vores fulde udvalg af webdesign- og SEO-tjenester.",
	canonical: "https://mintaka.co/da/404/",
};
---

<BaseLayout seo={seo}>
	<Error404 />
</BaseLayout>
