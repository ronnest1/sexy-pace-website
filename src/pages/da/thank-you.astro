---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Thanks from "@components/infopages/ThankYou.astro";

const seo: AstroSeoProps = {
	title: "Tak - Majestico Studio: E-mail sendt med succes",
	description:
		"Tak for at kontakte Majestico Studio! Din e-mail er sendt med succes. Vi sætter pris på din interesse og vil svare hurtigt.",
	canonical: "https://mintaka.co/da/thank-you/",
