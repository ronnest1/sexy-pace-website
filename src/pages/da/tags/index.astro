---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Tags from "@components/blog/Tags.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const seo: AstroSeoProps = {
	title: "Tags - Udforsk emner hos Majestico Studio",
	description:
		"Gennemse det mangfoldige udvalg af tags hos Majestico Studio for at finde artikler og indsigt, der er skræddersyet til dine interesser inden for webdesign og SEO.",
	canonical: "https://mintaka.co/da/tags/",
};
---

<BaseLayout seo={seo}>
	<Tags />
</BaseLayout>
