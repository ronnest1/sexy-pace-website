---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Authors from "@components/blog/Authors.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const allAuthors = await getCollection("authors");
const pageTitle = "Tag Index";

const seo: AstroSeoProps = {
	title: "Forfattere - Majestico Studio: Mød vores ekspertteam",
	description:
		"Opdag de kreative hjerner bag Majestico Studio. Vores forfattere er brancheeksperter inden for webdesign, SEO og digital marketing, der deler værdifuld indsigt.",
	canonical: "https://mintaka.co/da/author/",
