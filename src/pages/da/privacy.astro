---
import PrivacyPage from "@/components/infopages/Privacy.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Privatlivspolitik - Majestico Studio: Dit privatliv betyder noget",
	description:
		"Vores privatlivspolitik forklarer, hvordan Majestico Studio beskytter dine personlige oplysninger. Opdag vores engagement i dit privatliv og datasikkerhed.",
	canonical: "https://mintaka.co/da/privacy/",
};
---

<BaseLayout seo={seo}>
	<PrivacyPage />
</BaseLayout>
