---
import Layout from '../layouts/Layout.astro';
import EventList from '../components/EventList';
---
<Layout>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8 flex items-center justify-between">
      <h1 class="font-display text-4xl font-extrabold uppercase">Events</h1>
      <a href="/social-events/admin" class="inline-flex items-center gap-2 rounded-full border border-pink-600 px-4 py-2 text-sm font-semibold text-pink-600 transition hover:bg-pink-50">➕ Opret nyt event</a>
    </header>
    <EventList client:load />
  </section>
</Layout>
