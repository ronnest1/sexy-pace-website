---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { image, project, link, description, ctaText, class: className } = Astro.props;
---

<li class:list={["flex flex-col", className]}>
	<div class="relative">
		<div class="absolute inset-0 bg-pink-100 blur-sm rounded-md lg:rounded-lg transform scale-105"></div>
		<a href={link} aria-label={`Project ${project}`} class="relative block p-2">
			<Image class="h-[25rem] rounded-md object-cover lg:rounded-lg" src={image} alt={project} />
		</a>
	</div>
	<div class="px-2 py-8">
		<a href={link} class="flex items-center justify-between text-base font-medium lg:gap-x-8">
			<h3 class="font-mono text-xl font-bold uppercase tracking-wide md:mt-0 lg:text-2xl">
				{project}
			</h3>
			<span class="text-right text-base hover:text-pink-500">
				<span class="hidden lg:inline-block">{ctaText || t("projects.see")}</span>
				<span class="sr-only">{project}</span> &nbsp; &rarr;
			</span>
		</a>
		{description && <p class="mt-8 line-clamp-2 text-sm text-slate-500">{description}</p>}
	</div>
</li>
