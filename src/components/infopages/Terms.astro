---
import Title from "@components/global/Title.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section>
	<div class="mx-auto max-w-7xl px-8 py-12 md:px-12 lg:px-32 lg:py-32">
		<div>
			<Title title={t("terms.title")} subtitle={t("terms.updated")} class="pb-10 pt-20 uppercase" />
		</div>
		<div class="prose-styles mt-12 lg:mt-24">
			<p>{t("terms.intro")}</p>
			<h3>Use of the site</h3>
			<p>{t("terms.use")}</p>
			<h3>Liability</h3>
			<p>{t("terms.liability")}</p>
			<h3>Changes</h3>
			<p>{t("terms.changes")}</p>
			<h3>Contact</h3>
			<p>{t("terms.contact")}</p>
		</div>
	</div>
</section>
